def with_values($values):
  .engine += $values;

.[3] as $source
| ($source | with_values({
    "amp.out_master": -48,
    "mxrdis.on_off": 0,
    "ui.mxrdis": 0
  })) as $electric
| ($electric | with_values({
    "amp.clip.on_off": 0,
    "amp.out_master": -28,
    "antyfizz.on_off": 0,
    "cab_st.on_off": 0,
    "compressor.attack": 0.01,
    "compressor.knee": 4,
    "compressor.on_off": 1,
    "compressor.ratio": 3,
    "compressor.release": 0.25,
    "compressor.threshold": -24,
    "eq.bandwidth1": 50,
    "eq.bandwidth2": 180,
    "eq.bandwidth3": 700,
    "eq.bandwidth4": 1600,
    "eq.level1": -6,
    "eq.level2": -2,
    "eq.level3": 2,
    "eq.level4": 1,
    "eq.on_off": 1,
    "eq.peak1": 100,
    "eq.peak2": 250,
    "eq.peak3": 1800,
    "eq.peak4": 4500,
    "graphiceq.g1": -12,
    "graphiceq.g2": -8,
    "graphiceq.g3": -4,
    "graphiceq.g4": -2,
    "graphiceq.g5": 0,
    "graphiceq.g6": 1.5,
    "graphiceq.g7": 2,
    "graphiceq.g8": 1,
    "graphiceq.g9": 0,
    "graphiceq.g10": -1,
    "graphiceq.g11": -3,
    "graphiceq.on_off": 1,
    "gx_distortion.on_off": 0,
    "gxdistortion.drive": 0,
    "gxdistortion.wet_dry": 0,
    "jconv.on_off": 0,
    "stereoverb.LFO freq": 0.5,
    "stereoverb.RoomSize": 0.25,
    "stereoverb.damp": 0.45,
    "stereoverb.on_off": 1,
    "stereoverb.wet_dry": 12,
    "ui.antyfizz": 0,
    "ui.cab_st": 0,
    "ui.compressor": 1,
    "ui.eq": 1,
    "ui.graphiceq": 1,
    "ui.gx_distortion": 0,
    "ui.jconv": 0,
    "ui.stereoverb": 1
  })) as $acoustic
| ($electric | with_values({
    "amp.clip.on_off": 1,
    "amp.out_master": -35,
    "amp2.stage1.Pregain": -8,
    "amp2.stage2.gain1": 0.4,
    "antyfizz.on_off": 1,
    "bassEnhancer.Frequency": 90,
    "bassEnhancer.HarmonicsdB": 4,
    "bassEnhancer.on_off": 1,
    "cab_st.Level": 1,
    "cab_st.bass": 3,
    "cab_st.on_off": 1,
    "cab_st.select": "Bassman",
    "cab_st.treble": -2,
    "compressor.attack": 0.01,
    "compressor.knee": 4,
    "compressor.on_off": 1,
    "compressor.ratio": 4,
    "compressor.release": 0.2,
    "compressor.threshold": -22,
    "eq.bandwidth1": 45,
    "eq.bandwidth2": 180,
    "eq.bandwidth3": 700,
    "eq.bandwidth4": 1400,
    "eq.level1": 3,
    "eq.level2": -2,
    "eq.level3": 1.5,
    "eq.level4": -2,
    "eq.on_off": 1,
    "eq.peak1": 80,
    "eq.peak2": 300,
    "eq.peak3": 1200,
    "eq.peak4": 4000,
    "graphiceq.g1": 1,
    "graphiceq.g2": 3,
    "graphiceq.g3": 2,
    "graphiceq.g4": 0,
    "graphiceq.g5": -2,
    "graphiceq.g6": -1,
    "graphiceq.g7": 1,
    "graphiceq.g8": 0,
    "graphiceq.g9": -2,
    "graphiceq.g10": -5,
    "graphiceq.g11": -8,
    "graphiceq.on_off": 1,
    "gx_distortion.on_off": 0,
    "gxdistortion.drive": 0.35,
    "gxdistortion.wet_dry": 68,
    "jconv.on_off": 0,
    "stereoverb.on_off": 0,
    "tube.select": "12ax7",
    "ui.antyfizz": 1,
    "ui.bassEnhancer": 1,
    "ui.cab_st": 1,
    "ui.compressor": 1,
    "ui.eq": 1,
    "ui.graphiceq": 1,
    "ui.gx_distortion": 0,
    "ui.jconv": 0,
    "ui.stereoverb": 0
  })) as $bass
| . as $bank
| reduce range(2; length; 2) as $index (
    [$bank[0], $bank[1], "main", $electric, "Acoustic", $acoustic, "Rock Bass", $bass];
    if ["main", "Acoustic", "Rock Bass"] | index($bank[$index])
    then .
    else . + [$bank[$index], $bank[$index + 1]]
    end
  )
